<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.weibo.mapper.UserMapper">

    <select id="login" resultType="com.weibo.entity.User">
        select * from user where username = #{username} and password = #{password}
    </select>

    <insert id="register">
        insert into user(username,password) values(#{username},#{password})
    </insert>

    <select id="getById" resultType="com.weibo.entity.User">
        select * from user where id = #{id}
    </select>

    <select id="searchByUsername" resultType="com.weibo.entity.User">
        select * from user where username like concat('%', #{q}, '%') limit 20
    </select>

    <update id="updateById">
        update user
        <set>
            <if test="username != null">username = #{username},</if>
            <if test="avatar != null">avatar = #{avatar},</if>
            <if test="intro != null">intro = #{intro},</if>
            <if test="gender != null">gender = #{gender},</if>
            <if test="birthday != null">birthday = #{birthday},</if>
            <if test="email != null">email = #{email},</if>
            <if test="location != null">location = #{location},</if>
        </set>
        where id = #{id}
    </update>

</mapper>